// A larger grid, only run with TW_LARGE=1.
@tier(large)
program {
    fn run() -> i32 {
        let n: i32 = 0;
        repeat 1000 {
            n = (n + 1);
        }
        return (n + ambient(pos3).x);
    }
    unit u {
        main run;
    }
    entry u @dims(16, 16, 16) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[15, 0, 0] = 1015
