// Eager: a guarded density read still runs, so an out-of-range index fails the cell. Frontends
// clamp the index instead of guarding it with a select.
program {
    host i: i32;
    fn base_main() -> i32 {
        return (ambient(pos3).x * 10);
    }
    unit base {
        main base_main;
    }
    fn top_main() -> i32 @hosts(i) {
        return select(((host(i) >= 0) && (host(i) < 4)), density(b, host(i)), -1);
    }
    input b = base @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    unit top {
        main top_main;
        hosts [i];
        inputs [b];
    }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "in" origin(0, 0, 0) host(i = 3)
@case "out" origin(0, 0, 0) host(i = 4)
@expect "in" top[0, 0, 0] = 30
@expect "out" error(OutOfBounds)
