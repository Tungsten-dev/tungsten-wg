// Arms that read a density input and evaluate a unit. Both arms run in every cell, and an eval
// that is never selected (`only_unselected`) is still reached and scheduled.
program {
    fn base_main() -> i32 {
        return (ambient(pos3).x * 10);
    }
    unit base { main base_main; }
    fn probe_main() -> i32 {
        return (ambient(pos3).x + 1000);
    }
    unit probe { main probe_main; }
    fn top_main() -> i32 {
        return select((ambient(pos3).x == 0), density(b, ambient(pos3).x),
                      eval(probe, ambient(pos3)) @origin_scale(1, 1, 1) @position_scale(1, 1, 1));
    }
    input b = base @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    unit top {
        main top_main;
        inputs [b];
    }
    fn unselected_main() -> i32 {
        return select(true, 7, eval(probe, pos3(5, 0, 0)) @origin_scale(1, 1, 1) @position_scale(1, 1, 1));
    }
    unit only_unselected { main unselected_main; }
    entry top @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry only_unselected @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" top = [0, 1001]
@expect "c" only_unselected[0, 0, 0] = 7
