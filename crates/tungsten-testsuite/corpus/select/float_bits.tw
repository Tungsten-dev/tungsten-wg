// The chosen arm comes back bit for bit: -0.0 stays negative and NaN stays NaN.
program {
    fn run() -> [f64; 4] {
        return [select(true, -0.0, 0.0), select(false, 0.0, -0.0), select(true, nan, 1.0),
                select((ambient(pos3).x == 0), (0.0 * -1.0), 1.0)];
    }
    fn bits() -> [i64; 2] {
        return [ext double_to_bits(select(true, -0.0, 0.0)), ext double_to_bits(select(false, 1.0, nan))];
    }
    unit u { main run; }
    unit b { main bits; }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry b @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" u[0, 0, 0] = [-0.0, -0.0, nan, -0.0]
@expect "c" b[0, 0, 0] = [-9223372036854775808L, 9221120237041090560L]
