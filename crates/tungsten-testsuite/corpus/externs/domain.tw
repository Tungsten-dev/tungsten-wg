// An extern with a domain error.
program {
    host x: i32;
    fn run() -> i32 @hosts(x) {
        return ext test_domain(host(x));
    }
    unit u {
        main run;
        hosts [x];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "ok" origin(0, 0, 0) seed(1) host(x = 5)
@case "neg" origin(0, 0, 0) seed(1) host(x = -1)
@expect "ok" u[0, 0, 0] = 5
@expect "neg" error(ExternDomain)
