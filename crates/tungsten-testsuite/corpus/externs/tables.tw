// Toy tables: perm index wraps mod 256; the sampler is in [0, 1) and constant per cell.
program {
    table p = perlin("minecraft:offset", none, 0);
    table s = base3d;
    fn run() -> [bool; 4] {
        return [(ext perm_get(table(p), 5) == ext perm_get(table(p), 261)),
                (ext perm_get(table(p), -1) == ext perm_get(table(p), 255)),
                ((ext sampler_sample(table(s), vec3(1.5, -2.0, 3.0)) >= 0.0) && (ext sampler_sample(table(s), vec3(1.5, -2.0, 3.0)) < 1.0)),
                (ext sampler_sample(table(s), vec3(1.5, -2.0, 3.0)) == ext sampler_sample(table(s), vec3(1.9, -1.1, 3.9)))];
    }
    unit u {
        main run;
        tables [p, s];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [true, true, true, true]
