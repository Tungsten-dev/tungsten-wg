// Toy tables: perm index wraps mod 256; the sampler is in [0, 1) and constant per cell.
program {
    param seed: i64;
    auto p: handle PerlinNoiseSampler @name("minecraft:offset_0_") = make_permutation_table(param(seed), 577895406318539652L, 4557074653038767061L, 0L, 0L, 0L);
    auto s: handle InterpolatedNoiseSampler = make_base3d_perm_table(param(seed));
    fn run() -> [bool; 4] {
        return [(ext perm_get(auto(p), 5) == ext perm_get(auto(p), 261)),
                (ext perm_get(auto(p), -1) == ext perm_get(auto(p), 255)),
                ((ext sampler_sample(auto(s), vec3(1.5, -2.0, 3.0)) >= 0.0) && (ext sampler_sample(auto(s), vec3(1.5, -2.0, 3.0)) < 1.0)),
                (ext sampler_sample(auto(s), vec3(1.5, -2.0, 3.0)) == ext sampler_sample(auto(s), vec3(1.9, -1.1, 3.9)))];
    }
    unit u {
        main run;
        autos [p, s];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) param(seed = 1)
@expect "c" u[0, 0, 0] = [true, true, true, true]
