// float_to_bits, with the canonical NaN.
program {
    fn run() -> [i32; 3] {
        return [ext float_to_bits(1.0f), ext float_to_bits(nan_f32), ext float_to_bits(-0.0f)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [1065353216, 2143289344, -2147483648]
