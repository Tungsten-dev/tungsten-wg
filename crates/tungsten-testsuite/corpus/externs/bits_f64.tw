// double_to_bits, with the canonical NaN.
program {
    fn run() -> [i64; 3] {
        return [ext double_to_bits(1.0), ext double_to_bits(nan), ext double_to_bits(-0.0)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" u[0, 0, 0] = [4607182418800017408L, 9221120237041090560L, -9223372036854775808L]
