// A record inside a record, with a vec3 field.
program {
    host w: extern Wrap;
    fn run() -> extern Wrap @hosts(w) {
        return new Wrap { p: new Pair { a: (host(w).p.a - 1.0), b: (host(w).p.b + 1) }, v: (host(w).v + vec3(1.0, 2.0, 3.0)) };
    }
    unit u {
        main run;
        hosts [w];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1) host(w = new Wrap { p: new Pair { a: 0.5, b: -1 }, v: vec3(0.0, -0.0, 1.5) })
@expect "c" u[0, 0, 0] = new Wrap { p: new Pair { a: -0.5, b: 0 }, v: vec3(1.0, 2.0, 4.5) }
