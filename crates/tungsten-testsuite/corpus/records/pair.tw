// A record as a host input and as the result: fields are read, rebuilt and sent back unchanged in layout.
program {
    host h: extern Pair;
    fn run() -> extern Pair @hosts(h) {
        return new Pair { a: (host(h).a + 1.5), b: (host(h).b * 2) };
    }
    unit u {
        main run;
        hosts [h];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) host(h = new Pair { a: 2.0, b: 21 })
@expect "c" u[0, 0, 0] = new Pair { a: 3.5, b: 42 }
