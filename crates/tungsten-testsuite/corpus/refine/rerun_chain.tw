// Rerun: a chain of three rerun instances, each reading the next.
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    host k: i32;
    fn c_main() -> i32 @hosts(k) { return host(k); }
    unit cu { main c_main; hosts [k]; }
    input c = cu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn b_main() -> i32 { return (density(c) * 10); }
    unit bu { main b_main; inputs [c]; }
    input b = bu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn a_main() -> i32 { return (density(b) + 1); }
    unit au { main a_main; inputs [b]; }
    entry au @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of au {
        rerun au @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
        rerun bu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
        rerun cu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0) host(k = 1)
@refine "c" step offset(0, 0, 0) host(k = 2)
@expect "c" au = [11]
@expect "c" after(1) au = [21]
