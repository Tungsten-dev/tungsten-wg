// Multiple: two entries, only one refined. Orchestrate computes both.
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    host k: i32;
    fn a_main() -> i32 @hosts(k) { return host(k); }
    unit au { main a_main; hosts [k]; }
    fn b_main() -> i32 @hosts(k) { return (host(k) * 2); }
    unit bu { main b_main; hosts [k]; }
    entry au @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry bu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of au {
        rerun au @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0) host(k = 1)
@refine "c" step offset(0, 0, 0) host(k = 5)
@expect "c" au = [1]
@expect "c" bu = [2]
@expect "c" after(1) au = [5]
