// Rerun: a frozen instance that reads a rerun one keeps the value it computed from the old one.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    host k: i32;
    fn r_main() -> i32 @hosts(k) { return host(k); }
    unit ru { main r_main; hosts [k]; }
    input r = ru @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn f_main() -> i32 { return (density(r) * 100); }
    unit fu { main f_main; inputs [r]; }
    input f = fu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn top_main() -> i32 { return (density(f) + density(r)); }
    unit top { main top_main; inputs [f, r]; }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of top {
        rerun top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
        rerun ru @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0) host(k = 1)
@refine "c" step offset(0, 0, 0) host(k = 2)
@expect "c" top = [101]
@expect "c" after(1) top = [102]
