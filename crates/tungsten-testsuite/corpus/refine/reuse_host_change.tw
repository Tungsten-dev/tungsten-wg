// Reuse: when a host changes between calls, the frozen buffer keeps its value and the rerun one takes the new value.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    host k: i32;
    fn frozen_main() -> i32 @hosts(k) { return (host(k) * 10); }
    unit frozen { main frozen_main; hosts [k]; }
    fn live_main() -> i32 @hosts(k) { return host(k); }
    unit live { main live_main; hosts [k]; }
    input f = frozen @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    input r = live @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn top_main() -> i32 { return (density(f) + density(r)); }
    unit top { main top_main; inputs [f, r]; }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of top {
        rerun top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
        rerun live @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0) host(k = 1)
@refine "c" step offset(0, 0, 0) host(k = 2)
@refine "c" step offset(0, 0, 0) host(k = 3)
@expect "c" top = [11]
@expect "c" after(1) top = [12]
@expect "c" after(2) top = [13]
