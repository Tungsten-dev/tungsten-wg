// Multiple: two refined entries read the same instance. Each entry has its own buffers, so rerunning it for
// one leaves the other's frozen copy alone.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    host k: i32;
    fn s_main() -> i32 @hosts(k) { return host(k); }
    unit su { main s_main; hosts [k]; }
    input s = su @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn a_main() -> i32 { return density(s); }
    unit au { main a_main; inputs [s]; }
    fn b_main() -> i32 { return (density(s) + 100); }
    unit bu { main b_main; inputs [s]; }
    entry au @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry bu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement ra of au {
        rerun au @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
        rerun su @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
    refinement rb of bu {
        rerun bu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0) host(k = 1)
@refine "c" ra offset(0, 0, 0) host(k = 7)
@refine "c" rb offset(0, 0, 0) host(k = 9)
@expect "c" au = [1]
@expect "c" bu = [101]
@expect "c" after(1) au = [7]
@expect "c" after(2) bu = [101]
