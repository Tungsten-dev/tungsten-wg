// Schedule: a rerun instance that only a rerun reads isn't computed by orchestrate. It would divide by zero there.
program {
    host k: i32;
    fn d_main() -> i32 @hosts(k) { return (1 / (host(k) - 1)); }
    unit du { main d_main; hosts [k]; }
    input d = du @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn seed_main() -> i32 { return 0; }
    unit seed { main seed_main; }
    fn w_main() -> i32 { return density(d); }
    unit w { main w_main; inputs [d]; }
    entry seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of seed {
        rerun seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) with w;
        rerun du @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0) host(k = 1)
@refine "c" step offset(0, 0, 0) host(k = 2)
@expect "c" seed = [0]
@expect "c" after(1) seed = [1]
