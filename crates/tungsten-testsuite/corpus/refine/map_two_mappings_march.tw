// Mappings: one frozen grid read through two inputs, `@expand` and `@lerp`, along the march.
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn g_main() -> f64 { return ((ambient(pos3).y * 4) as f64); }
    unit gu { main g_main; }
    input a = gu @dims(1, 3, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(*, 2, *);
    input b = gu @dims(1, 3, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @lerp(*, 2, *);
    fn top_main() -> f64 { return ((density(a) * 100.0) + density(b)); }
    unit top { main top_main; inputs [a, b]; }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of top @march(0, 3, 0) {
        rerun top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0)
@refine "c" step offset(0, 1, 0)
@refine "c" step offset(0, 2, 0)
@refine "c" step offset(0, 3, 0)
@expect "c" top = [0.0]
@expect "c" after(1) top = [2.0]
@expect "c" after(2) top = [404.0]
@expect "c" after(3) top = [406.0]
