// March: no `@march`, so the only offset is zero. The call still reruns with the new hosts.
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    host k: i32;
    fn pos_main() -> i32 @hosts(k) { return (ambient(pos3).x + host(k)); }
    unit pos { main pos_main; hosts [k]; }
    entry pos @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of pos {
        rerun pos @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0) host(k = 0)
@refine "c" step offset(0, 0, 0) host(k = 5)
@expect "c" pos = [0, 1]
@expect "c" after(1) pos = [5, 6]
