// Mappings: the last valid offset reads the input's last cell on the marched axis.
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn g_main() -> i32 { return ((ambient(pos3).y * 3) + 1); }
    unit gu { main g_main; }
    input g = gu @dims(1, 2, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(*, 1, *);
    fn top_main() -> i32 { return density(g); }
    unit top { main top_main; inputs [g]; }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of top @march(0, 1, 0) {
        rerun top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0)
@refine "c" step offset(0, 1, 0)
@expect "c" top = [1]
@expect "c" after(1) top = [4]
