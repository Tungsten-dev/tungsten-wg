// March: along x and z.
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn pos_main() -> i32 { return (ambient(pos3).x + (100 * ambient(pos3).z)); }
    unit pos { main pos_main; }
    entry pos @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of pos @march(3, 0, 2) {
        rerun pos @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0)
@refine "c" step offset(3, 0, 0)
@refine "c" step offset(0, 0, 2)
@refine "c" step offset(3, 0, 2)
@expect "c" pos = [0]
@expect "c" after(1) pos = [3]
@expect "c" after(2) pos = [200]
@expect "c" after(3) pos = [203]
