// Schedule: a frozen instance that only a refinement reads is computed by orchestrate, with its hosts.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    host k: i32;
    fn f_main() -> i32 @hosts(k) { return (host(k) * 10); }
    unit fu { main f_main; hosts [k]; }
    input f = fu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn seed_main() -> i32 { return 0; }
    unit seed { main seed_main; }
    fn w_main() -> i32 @hosts(k) { return (density(f) + host(k)); }
    unit w { main w_main; hosts [k]; inputs [f]; }
    entry seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of seed {
        rerun seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) with w;
    }
}
@case "c" origin(0, 0, 0) host(k = 1)
@refine "c" step offset(0, 0, 0) host(k = 2)
@expect "c" seed = [0]
@expect "c" after(1) seed = [12]
