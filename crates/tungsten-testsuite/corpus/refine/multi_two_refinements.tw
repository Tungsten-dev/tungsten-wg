// Multiple: two refinements of one entry share its buffers, so each continues from the other's output.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn seed_main() -> i32 { return 0; }
    unit seed { main seed_main; }
    input pa = seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @previous;
    input pd = seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @previous;
    fn add_main() -> i32 { return (density(pa) + 1); }
    unit adder { main add_main; inputs [pa]; }
    fn dbl_main() -> i32 { return (density(pd) * 2); }
    unit doubler { main dbl_main; inputs [pd]; }
    entry seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement add of seed {
        rerun seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) with adder;
    }
    refinement dbl of seed {
        rerun seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) with doubler;
    }
}
@case "c" origin(0, 0, 0)
@refine "c" add offset(0, 0, 0)
@refine "c" dbl offset(0, 0, 0)
@refine "c" add offset(0, 0, 0)
@refine "c" dbl offset(0, 0, 0)
@expect "c" seed = [0]
@expect "c" after(1) seed = [1]
@expect "c" after(2) seed = [2]
@expect "c" after(3) seed = [3]
@expect "c" after(4) seed = [6]
