// March: computing a volume one slice at a time, top-down, gives the same bits as the full 3D entry.
// `tests/marched_slices.rs` compares every slice with `full`, by bits; the expectations here are spot checks.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn coarse_main() -> f64 {
        let y: i32 = ambient(pos3).y;
        return (((((y * y) + ambient(pos3).x) as f64) * 0.7) + 0.1);
    }
    unit coarse { main coarse_main; }
    input g = coarse @dims(2, 3, 2) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @lerp(1, 3, 1);
    fn f_main() -> f64 {
        let c: pos3 = ambient(pos3);
        return ((density(g) + ((c.x as f64) * 0.1)) + ((c.z as f64) * 0.01));
    }
    unit f { main f_main; inputs [g]; }
    entry full = f @dims(2, 4, 2) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry slice = f @dims(2, 1, 2) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement down of slice @march(0, 3, 0) {
        rerun f @dims(2, 1, 2) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0)
@refine "c" down offset(0, 3, 0)
@refine "c" down offset(0, 2, 0)
@refine "c" down offset(0, 1, 0)
@refine "c" down offset(0, 0, 0)
@expect "c" full[0, 0, 0] = 0.1
@expect "c" after(4) slice[0, 0, 0] = 0.1
