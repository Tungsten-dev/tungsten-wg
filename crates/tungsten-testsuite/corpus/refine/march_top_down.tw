// March: a top-down surface search. Each column keeps the first solid y (y <= 2) found from the top, or -1.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn seed_main() -> i32 { return -1; }
    unit seed { main seed_main; }
    input prev = seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @previous;
    fn surf_main() -> i32 {
        let y: i32 = ambient(pos3).y;
        if (density(prev) >= 0) {
            return density(prev);
        }
        if (y <= 2) {
            return y;
        }
        return -1;
    }
    unit surf { main surf_main; inputs [prev]; }
    entry seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement down of seed @march(0, 5, 0) {
        rerun seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) with surf;
    }
}
@case "c" origin(0, 0, 0)
@refine "c" down offset(0, 5, 0)
@refine "c" down offset(0, 4, 0)
@refine "c" down offset(0, 3, 0)
@refine "c" down offset(0, 2, 0)
@refine "c" down offset(0, 1, 0)
@expect "c" seed = [-1]
@expect "c" after(1) seed = [-1]
@expect "c" after(2) seed = [-1]
@expect "c" after(3) seed = [-1]
@expect "c" after(4) seed = [2]
@expect "c" after(5) seed = [2]
