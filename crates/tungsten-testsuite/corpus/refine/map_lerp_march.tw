// Mappings: `@lerp` along the march across a frozen coarse grid gives, slice by slice, what the same grid read
// at full resolution gives (`full`: 0, 5, 10, 15).
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn coarse_main() -> f64 { return ((ambient(pos3).y * 10) as f64); }
    unit coarse { main coarse_main; }
    input g = coarse @dims(1, 3, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @lerp(*, 2, *);
    fn full_main() -> f64 { return density(g); }
    unit full { main full_main; inputs [g]; }
    fn slice_main() -> f64 { return density(g); }
    unit slice { main slice_main; inputs [g]; }
    entry full @dims(1, 4, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry slice @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement down of slice @march(0, 3, 0) {
        rerun slice @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0)
@refine "c" down offset(0, 3, 0)
@refine "c" down offset(0, 2, 0)
@refine "c" down offset(0, 1, 0)
@refine "c" down offset(0, 0, 0)
@expect "c" full = [0.0, 5.0, 10.0, 15.0]
@expect "c" slice = [0.0]
@expect "c" after(1) slice = [15.0]
@expect "c" after(2) slice = [10.0]
@expect "c" after(3) slice = [5.0]
@expect "c" after(4) slice = [0.0]
