// Rerun: a refined unit runs in place of the entry's unit and writes its buffer.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn seed_main() -> i32 { return 5; }
    unit seed { main seed_main; }
    fn other_main() -> i32 { return (7 + ambient(pos3).x); }
    unit other { main other_main; }
    entry seed @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of seed {
        rerun seed @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) with other;
    }
}
@case "c" origin(0, 0, 0)
@refine "c" step offset(0, 0, 0)
@expect "c" seed = [5, 5]
@expect "c" after(1) seed = [7, 8]
