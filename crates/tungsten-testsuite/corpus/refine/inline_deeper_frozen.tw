// Inlining: deeper in a frozen closure inlining still happens (`g` into `f`) and doesn't change frozen values.
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    host k: i32;
    fn g_main() -> i32 @hosts(k) { return (host(k) * 10); }
    unit gu { main g_main; hosts [k]; }
    input g = gu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn f_main() -> i32 { return (density(g) + 1); }
    unit fu { main f_main; inputs [g]; }
    input f = fu @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn top_main() -> i32 @hosts(k) { return (density(f) + host(k)); }
    unit top { main top_main; hosts [k]; inputs [f]; }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of top {
        rerun top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    }
}
@case "c" origin(0, 0, 0) host(k = 1)
@refine "c" step offset(0, 0, 0) host(k = 2)
@expect "c" top = [12]
@expect "c" after(1) top = [13]
