// i64 shift amounts are masked to 6 bits.
@knownfail(rust, "the backend emits plain <<, which panics on a shift amount of the type width or more instead of masking it")
@knownfail(java, "derive_binop_type has no result type for shift and bitwise operators, so an array literal starting with one panics in the Java backend")
program {
    fn run() -> [i64; 1] {
        return [(1L << 65)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" u[0, 0, 0] = [2L]
