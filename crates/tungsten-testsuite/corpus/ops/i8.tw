// i8: arithmetic shift right promotes to i32 and truncates.
program {
    fn run() -> [i8; 1] {
        return [(-128b >> 1)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [-64b]
