// i8 ops promote to i32, apply the i32 rule and truncate.
program {
    fn run() -> [i8; 6] {
        return [(127b + 1b), (100b * 3b), (-128b - 1b), (-128b / -1b), (1b << 9), (-128b >> 1)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [-128b, 44b, 127b, -128b, 0b, -64b]
