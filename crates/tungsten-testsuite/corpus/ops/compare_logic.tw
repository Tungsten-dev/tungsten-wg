// Comparisons (NaN is unordered, -0.0 == 0.0) and logical operators.
program {
    fn run() -> [bool; 8] {
        return [(nan == nan), (nan != nan), (nan < 1.0), (1.0 <= 1.0), (-0.0 == 0.0),
                (3 > 2), ((1 < 2) && (2 < 3)), ((1 > 2) || (2 > 3))];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" u[0, 0, 0] = [false, true, false, true, true, true, true, false]
