// i32 arithmetic wraps, division truncates, shift amounts are masked.
program {
    fn run() -> [i32; 12] {
        return [(2147483647 + 1), (-2147483648 - 1), (65536 * 65536), (-2147483648 / -1),
                (-7 / 2), (1 << 33), (-8 >> 1), (-8 >>> 28), (5 & 3), (5 | 3), (5 ^ 3), !5];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [-2147483648, 2147483647, 0, -2147483648, -3, 2, -4, 15, 1, 7, 6, -6]
