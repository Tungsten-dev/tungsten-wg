// i32: division truncates, arithmetic shift right, bit operations.
program {
    fn run() -> [i32; 6] {
        return [(-7 / 2), (-8 >> 1), (5 & 3), (5 | 3), (5 ^ 3), !5];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" u[0, 0, 0] = [-3, -4, 1, 7, 6, -6]
