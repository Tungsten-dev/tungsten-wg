// i32 subtraction wraps on overflow.
@knownfail(rust, "the backend emits plain operators, which panic on overflow instead of wrapping like Java")
program {
    fn run() -> [i32; 1] {
        return [(-2147483648 - 1)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [2147483647]
