// i64 MIN / -1 wraps to MIN instead of trapping.
@knownfail(rust, "the backend emits plain /, which panics on MIN / -1 instead of wrapping like Java")
program {
    fn run() -> [i64; 1] {
        return [(-9223372036854775808L / -1L)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [-9223372036854775808L]
