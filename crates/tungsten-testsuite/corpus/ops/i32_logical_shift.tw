// i32 logical shift right is unsigned.
@knownfail(rust, "the backend emits >>> as >>, an arithmetic shift on signed types")
program {
    fn run() -> [i32; 1] {
        return [(-8 >>> 28)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [15]
