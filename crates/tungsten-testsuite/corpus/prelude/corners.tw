// Prelude: corner bit helpers.
program {
    use prelude::{corner_x, corner_y, corner_z};
    fn run() -> [i32; 3] {
        return [corner_x(5), corner_y(5), corner_z(5)];
    }
    unit u {
        main run;
        helpers [corner_x, corner_y, corner_z];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" u[0, 0, 0] = [1, 0, 1]
