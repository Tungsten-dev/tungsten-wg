// Prelude transcendentals agree with libm to 1e-9; log of a negative is NaN.
program {
    use prelude::{sin, cos, exp, log, pow};
    fn run() -> [bool; 8] {
        return [(ext abs((sin(1.0) - 0.8414709848078965)) < 1e-9),
                (ext abs((cos(1.0) - 0.5403023058681398)) < 1e-9),
                (ext abs((exp(1.0) - 2.718281828459045)) < 1e-9),
                (ext abs((log(10.0) - 2.302585092994046)) < 1e-9),
                (ext abs((pow(2.0, 10.0) - 1024.0)) < 1e-9),
                (ext abs((sin(100.0) - -0.5063656411097588)) < 1e-9),
                (ext abs((exp(-5.0) - 0.006737946999085467)) < 1e-9),
                (log(-1.0) != log(-1.0))];
    }
    unit u {
        main run;
        helpers [sin, cos, exp, log, pow];
        consts [TAU, LN2];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [true, true, true, true, true, true, true, true]
