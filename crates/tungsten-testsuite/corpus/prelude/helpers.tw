// Prelude: lerp, smoothstep, as_index.
program {
    use prelude::{lerp, smoothstep, as_index};
    fn run() -> [f64; 5] {
        return [lerp(0.0, 10.0, 0.25), smoothstep(0.0, 1.0, 0.5), smoothstep(0.0, 1.0, 2.0),
                smoothstep(0.0, 1.0, -1.0), (as_index(1, 2, 3, 4, 5) as f64)];
    }
    unit u {
        main run;
        helpers [lerp, smoothstep, as_index];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [2.5, 0.5, 1.0, 0.0, 69.0]
