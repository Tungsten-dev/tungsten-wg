// An input no unit lists is inert: its failing source is never built.
program {
    fn bad_main() -> i32 {
        return (1 / 0);
    }
    unit bad {
        main bad_main;
    }

    input b = bad @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);

    fn top_main() -> i32 {
        return 3;
    }
    unit top {
        main top_main;
    }

    entry top @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" top = [3, 3]
