// Inlining: a callee with its own mapped input is inlined, and the caller lists that input from then on.
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn leaf() -> i32 {
        return (ambient(pos3).x * 10);
    }
    unit leaf_u {
        main leaf;
    }

    input m = leaf_u @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(2, *, *);

    fn mid_main() -> i32 {
        return (density(m) + 1);
    }
    unit mid {
        main mid_main;
        inputs [m];
    }

    input x = mid @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);

    fn top() -> i32 {
        return (density(x) * 2);
    }
    unit t {
        main top;
        inputs [x];
    }
    entry t @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [2, 2, 22, 22]
