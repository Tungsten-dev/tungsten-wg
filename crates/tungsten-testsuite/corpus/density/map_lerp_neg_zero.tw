// Lerp bits: a -0.0 low corner at t = 0 gives +0.0 (-0.0 + 0 * (b - a)), so `t == 0` can't be skipped.
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn leaf() -> f64 {
        let c: pos3 = ambient(pos3);
        if (c.x == 0) { return -0.0; } return 1.0;
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @lerp(2, *, *);

    fn top() -> f64 {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [0.0, 0.5]
