// Lerp: the last reader cell of each axis reads the input's last high corner.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn leaf() -> f64 {
        let c: pos3 = ambient(pos3);
        return (((c.x + (10 * c.y)) + (100 * c.z)) as f64);
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(3, 3, 3) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @lerp(2, 2, 2);

    fn top() -> f64 {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(4, 4, 4) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t[0, 0, 0] = 0.0
@expect "c" t[3, 0, 0] = 1.5
@expect "c" t[0, 3, 0] = 15.0
@expect "c" t[0, 0, 3] = 150.0
@expect "c" t[3, 3, 3] = 166.5
@expect "c" t[2, 1, 3] = 156.0
