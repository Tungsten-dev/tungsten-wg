// Different dims: an un-indexed read across shapes is no longer legal (strict 1-to-1).
program {
    fn base_main() -> i32 {
        return ((ambient(pos3).x * 10) + ambient(pos3).y);
    }
    unit base {
        main base_main;
    }

    fn top_main() -> i32 {
        return density(b);
    }
    input b = base @dims(2, 2, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    unit top {
        main top_main;
        inputs [b];
    }
    entry top @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(MappingDimsMismatch)
