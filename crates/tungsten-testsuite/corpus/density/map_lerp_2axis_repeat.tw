// Lerp: x and z interpolated, `*` on y. Corner values aren't linear.
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn leaf() -> f64 {
        let c: pos3 = ambient(pos3);
        return (((c.x * c.x) + ((10 * c.z) * c.z)) as f64);
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(3, 1, 3) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @lerp(2, *, 2);

    fn top() -> f64 {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(4, 3, 3) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [0.0, 0.5, 1.0, 2.5, 0.0, 0.5, 1.0, 2.5, 0.0, 0.5, 1.0, 2.5, 5.0, 5.5, 6.0, 7.5, 5.0, 5.5, 6.0, 7.5, 5.0, 5.5, 6.0, 7.5, 10.0, 10.5, 11.0, 12.5, 10.0, 10.5, 11.0, 12.5, 10.0, 10.5, 11.0, 12.5]
