// Lerp: an f32 input interpolates in f32, rounding after each step.
program {
    fn leaf() -> f32 {
        let c: pos3 = ambient(pos3);
        if (c.x == 0) { return 0.1f; } return 0.7f;
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @lerp(3, *, *);

    fn top() -> f32 {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(3, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [0.1f, 0.29999998f, 0.49999997f]
