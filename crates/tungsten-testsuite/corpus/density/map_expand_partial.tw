// Expand: a reader smaller than the mapping allows is legal and reads the start of the input.
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn leaf() -> i32 {
        let c: pos3 = ambient(pos3);
        return (c.x + (10 * c.y));
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(4, 2, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(2, 1, *);

    fn top() -> i32 {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(3, 2, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [0, 0, 1, 10, 10, 11]
