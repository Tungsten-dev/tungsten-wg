// Expand: any element type is allowed, here an array.
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn leaf() -> [i32; 2] {
        let c: pos3 = ambient(pos3);
        return [c.x, (c.x * c.x)];
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(3, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(2, *, *);

    fn top() -> [i32; 2] {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(5, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t[0, 0, 0] = [0, 0]
@expect "c" t[1, 0, 0] = [0, 0]
@expect "c" t[2, 0, 0] = [1, 1]
@expect "c" t[3, 0, 0] = [1, 1]
@expect "c" t[4, 0, 0] = [2, 4]
