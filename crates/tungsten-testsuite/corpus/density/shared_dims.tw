// Shared inputs read by units with different dims: a (1,1,1) input through a shared helper, and a
// (4,1,1) input read un-indexed at its own dims and through explicit indices from other grids.
program {
    fn base_main() -> i32 {
        return (ambient(pos3).x * 10);
    }
    unit base {
        main base_main;
    }

    fn seven() -> i32 {
        return 7;
    }
    unit one_u {
        main seven;
    }

    input b = base @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    input one = one_u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(*, *, *);

    fn read_one() -> i32 {
        return density(one);
    }

    fn wide_main() -> i32 {
        return (read_one() + density(b));
    }
    unit wide {
        main wide_main;
        helpers [read_one];
        inputs [one, b];
    }

    fn square_main() -> i32 {
        return (read_one() + density(b, (ambient(pos3).x + (ambient(pos3).y * 2))));
    }
    unit square {
        main square_main;
        helpers [read_one];
        inputs [b, one];
    }

    fn idx_main() -> i32 {
        return (read_one() + density(b, (3 - ambient(pos3).x)));
    }
    unit idx {
        main idx_main;
        helpers [read_one];
        inputs [one, b];
    }

    entry wide @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry square @dims(2, 2, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry idx @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" wide = [7, 17, 27, 37]
@expect "c" square = [7, 17, 27, 37]
@expect "c" idx = [37, 27]
