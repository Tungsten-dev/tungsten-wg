// Two inputs of one unit differing only in origin_scale must not share a buffer.
program {
    fn base_main() -> f64 {
        return ambient(origin_scale).x;
    }
    unit base {
        main base_main;
    }

    fn top_main() -> f64 {
        return (density(a) + (10.0 * density(b)));
    }
    input a = base @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    input b = base @dims(1, 1, 1) @origin_scale(2, 2, 2) @position_scale(1, 1, 1);
    unit top {
        main top_main;
        inputs [a, b];
    }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" top[0, 0, 0] = 21.0
