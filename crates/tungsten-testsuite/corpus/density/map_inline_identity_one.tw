// Inlining: a (1,1,1) input with all `*`, read from a (1,1,1) reader, is identity on its grid and is inlined.
program {
    fn leaf() -> i32 {
        return 7;
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(*, *, *);

    fn top() -> i32 {
        return (density(d) * 2);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [14]
