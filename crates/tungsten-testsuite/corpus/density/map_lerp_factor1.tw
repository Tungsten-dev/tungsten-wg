// Lerp: factor 1 doesn't interpolate, so x reads the reader's own column.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn leaf() -> f64 {
        let c: pos3 = ambient(pos3);
        return ((c.x + (10 * c.y)) as f64);
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(3, 2, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @lerp(1, 2, *);

    fn top() -> f64 {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(3, 2, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [0.0, 1.0, 2.0, 5.0, 6.0, 7.0]
