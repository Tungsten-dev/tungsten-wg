// A shared failing input fails a unit that lists it without reading it. `lister` is the first
// entry, so its failure is the one `error(...)` matches.
program {
    fn bad_main() -> i32 {
        return (1 / 0);
    }
    unit bad {
        main bad_main;
    }

    input b = bad @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(*, *, *);

    fn lister_main() -> i32 {
        return 1;
    }
    unit lister {
        main lister_main;
        inputs [b];
    }

    fn reader_main() -> i32 {
        return density(b);
    }
    unit reader {
        main reader_main;
        inputs [b];
    }

    entry lister @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry reader @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" error(DivByZero)
