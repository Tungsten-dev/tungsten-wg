// Expand: any element type is allowed, here a record.
@knownfail(rust, "pending: combined-rollout phase 2B")
@knownfail(java, "pending: combined-rollout phase 3")
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn leaf() -> extern Pair {
        let c: pos3 = ambient(pos3);
        return new Pair { a: (c.x as f64), b: (c.x * 3) };
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(2, *, *);

    fn top() -> extern Pair {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [new Pair { a: 0.0, b: 0 }, new Pair { a: 0.0, b: 0 }, new Pair { a: 1.0, b: 3 }, new Pair { a: 1.0, b: 3 }]
