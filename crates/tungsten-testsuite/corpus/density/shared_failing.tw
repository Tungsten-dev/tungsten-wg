// A failing shared input fails both of its readers. The interpreter reports it once
// (`tungsten-check`'s `shared_input_failure`).
program {
    fn bad_main() -> i32 {
        return (1 / (ambient(pos3).x - 2));
    }
    unit bad {
        main bad_main;
    }

    input b = bad @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);

    fn shared() -> i32 {
        return density(b);
    }

    fn left_main() -> i32 {
        return shared();
    }
    unit left {
        main left_main;
        helpers [shared];
        inputs [b];
    }

    fn right_main() -> i32 {
        return (density(b) + 1);
    }
    unit right {
        main right_main;
        inputs [b];
    }

    entry left @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry right @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" error(DivByZero)
