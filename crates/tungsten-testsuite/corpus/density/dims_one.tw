// A (1,1,1) input is read at cell 0 by every cell of the reader.
program {
    fn base_main() -> f64 {
        return 2.5;
    }
    unit base {
        main base_main;
    }

    fn top_main() -> f64 {
        return (density(b) * 2.0);
    }
    input b = base @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    unit top {
        main top_main;
        inputs [b];
    }
    entry top @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" top[*] = 5.0
