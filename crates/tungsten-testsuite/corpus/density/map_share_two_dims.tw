// One unit at two reader dims reads the same mapped input.
@knownfail(cuda, "pending: combined-rollout phase 4")
program {
    fn leaf() -> i32 {
        return (ambient(pos3).x * 10);
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(3, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(2, *, *);

    fn top() -> i32 {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry four = t @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry six = t @dims(6, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" four = [0, 0, 10, 10]
@expect "c" six = [0, 0, 10, 10, 20, 20]
