// Identity: an input read only through an explicit index has no reader rule, so its dims may differ.
program {
    fn leaf() -> i32 {
        let c: pos3 = ambient(pos3);
        return (c.x * 10);
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(4, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);

    fn top() -> i32 {
        return density(d, ((ambient(pos3).x * 2) + 1));
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [10, 30]
