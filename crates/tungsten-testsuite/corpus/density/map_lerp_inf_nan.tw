// Lerp bits: an infinite or NaN high corner at t = 0 still makes the result NaN (0 * inf).
program {
    fn leaf() -> f64 {
        let c: pos3 = ambient(pos3);
        if (c.x == 0) { return 1.0; } if (c.z == 0) { return (1.0 / 0.0); } return (0.0 / 0.0);
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(2, 1, 2) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @lerp(2, *, 1);

    fn top() -> f64 {
        return density(d);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(2, 1, 2) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [nan, inf, nan, nan]
