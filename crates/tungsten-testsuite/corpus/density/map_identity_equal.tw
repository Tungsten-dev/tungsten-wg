// Identity: an un-indexed read of an input with the reader's dims reads the reader's own cell.
program {
    fn leaf() -> i32 {
        let c: pos3 = ambient(pos3);
        return (c.x + (10 * c.y));
    }
    unit leaf_u {
        main leaf;
    }

    input d = leaf_u @dims(3, 2, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);

    fn top() -> i32 {
        return (density(d) + 1);
    }
    unit t {
        main top;
        inputs [d];
    }
    entry t @dims(3, 2, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" t = [1, 2, 3, 11, 12, 13]
