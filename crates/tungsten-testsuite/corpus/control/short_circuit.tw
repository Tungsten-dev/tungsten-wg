// && and || do not evaluate the right side when the left decides.
program {
    fn run() -> [bool; 2] {
        return [(false && ((1 / 0) == 0)), (true || ((1 / 0) == 0))];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [false, true]
