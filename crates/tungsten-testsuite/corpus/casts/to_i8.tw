// Casts to i8 go through i32 and then truncate, like Java (byte).
program {
    fn run() -> [i8; 5] {
        return [(300.0 as i8), (200 as i8), (-129 as i8), (nan as i8), (4294967297L as i8)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [44b, -56b, 127b, 0b, 1b]
