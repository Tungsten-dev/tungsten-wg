// Casts to i32: float to int rounds toward zero, saturates and maps NaN to 0; i64 truncates.
program {
    fn run() -> [i32; 8] {
        return [(1e10 as i32), (-1e10 as i32), (nan as i32), (-1.9 as i32), (4294967297L as i32),
                (-128b as i32), (2147483648.0 as i32), (0.9 as i32)];
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) seed(1)
@expect "c" u[0, 0, 0] = [2147483647, -2147483648, 0, -1, 1, -128, 2147483647, 0]
