// Integer division by zero fails the cell.
program {
    host d: i32;
    fn run() -> i32 @hosts(d) {
        return (1 / host(d));
    }
    unit u {
        main run;
        hosts [d];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "zero" origin(0, 0, 0) host(d = 0)
@case "ok" origin(0, 0, 0) host(d = 2)
@expect "zero" error(DivByZero)
@expect "ok" u[0, 0, 0] = 0
