// OutOfFuel is interpreter-only (crate README, "Rules and contracts").
@fuel(100)
program {
    fn run() -> i32 {
        let n: i32 = 0;
        while true {
            n = (n + 1);
        }
        return n;
    }
    unit u {
        main run;
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" error(OutOfFuel)
