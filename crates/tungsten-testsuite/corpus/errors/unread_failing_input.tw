// A failing density input fails the case, even if nothing reads it.
program {
    fn base_main() -> i32 {
        return (1 / 0);
    }
    unit base {
        main base_main;
    }

    fn top_main() -> i32 {
        return 1;
    }
    input b = base @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    unit top {
        main top_main;
        inputs [b];
    }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" error(DivByZero)
