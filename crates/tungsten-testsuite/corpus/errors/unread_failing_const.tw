// A failing const fails the whole case, even if nothing reads it (TESTING.md §2).
@knownfail(rust, "Rust const items are evaluated at compile time, so `const bad = 1 / 0` is a build error (E0080) instead of a runtime failure")
program {
    const bad = (1 / 0);
    fn run() -> i32 {
        return 1;
    }
    unit u {
        main run;
        consts [bad];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" error(DivByZero)
