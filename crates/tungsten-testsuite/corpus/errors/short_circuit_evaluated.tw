// The right side of && is evaluated when the left is true.
program {
    host d: i32;
    fn run() -> bool @hosts(d) {
        return (true && ((1 / host(d)) == 0));
    }
    unit u {
        main run;
        hosts [d];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "zero" origin(0, 0, 0) seed(1) host(d = 0)
@case "ok" origin(0, 0, 0) seed(1) host(d = 2)
@expect "zero" error(DivByZero)
@expect "ok" u[0, 0, 0] = true
