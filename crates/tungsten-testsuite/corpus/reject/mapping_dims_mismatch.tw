// An un-indexed Identity read of a (1,1,1) input from a larger grid needs `@expand(*, *, *)`.
program {
    fn leaf() -> i32 { return 1; }
    unit leaf_u { main leaf; }
    input d = leaf_u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn top() -> i32 { return density(d); }
    unit t { main top; inputs [d]; }
    entry t @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(MappingDimsMismatch)
