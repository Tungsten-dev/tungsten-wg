// A `@previous` input means the reader's own cell, so an evaluated body can't read it.
program {
    fn seed_main() -> f64 { return 0.0; }
    unit seed { main seed_main; }
    input prev = seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @previous;
    fn w_main() -> f64 { return (density(prev) + eval(w, pos3(0, 0, 0)) @origin_scale(1, 1, 1) @position_scale(1, 1, 1)); }
    unit w { main w_main; inputs [prev]; }
    entry seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of seed { rerun seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) with w; }
}
@expect reject(EvalPrevious)
