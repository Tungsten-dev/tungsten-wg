// Expand: a reader past the input's grid ((r - 1) / n >= s on x).
program {
    fn leaf() -> i32 { return 1; }
    unit leaf_u { main leaf; }
    input d = leaf_u @dims(2, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(2, *, *);
    fn top() -> i32 { return density(d); }
    unit t { main top; inputs [d]; }
    entry t @dims(5, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(MappingOutOfRange)
