// An evaluated body can't read an input without an index: there is no cell to map from.
program {
    fn base_main() -> f64 { return 1.0; }
    unit base { main base_main; }
    input b = base @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn probe_main() -> f64 { return density(b); }
    unit probe { main probe_main; inputs [b]; }
    fn top_main() -> f64 { return eval(probe, ambient(pos3)) @origin_scale(1, 1, 1) @position_scale(1, 1, 1); }
    unit top { main top_main; }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(EvalUnindexedRead)
