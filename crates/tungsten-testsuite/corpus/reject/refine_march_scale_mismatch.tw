// Targets with different position scales on a marched axis.
program {
    fn seed_main() -> f64 { return 0.0; }
    unit seed { main seed_main; inputs [d]; }
    fn d_main() -> f64 { return 2.0; }
    unit du { main d_main; }
        input d = du @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 2, 1);
    entry seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);

    refinement step of seed @march(0, 2, 0) { rerun seed @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1); rerun du @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 2, 1); }
}
@expect reject(RefineMarchScaleMismatch)
