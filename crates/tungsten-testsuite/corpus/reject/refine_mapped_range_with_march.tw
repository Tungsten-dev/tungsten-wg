// A mapped read that fits the grid at offset 0 but not with the march: (1 - 1 + 3) / 1 = 3 is past a 3-high input.
program {
    fn g_main() -> i32 { return 1; }
    unit gu { main g_main; }
    input g = gu @dims(1, 3, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1) @expand(*, 1, *);
    fn top_main() -> i32 { return density(g); }
    unit top { main top_main; inputs [g]; }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    refinement step of top @march(0, 3, 0) { rerun top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1); }
}
@expect reject(MappingOutOfRange)
