// Records (and arrays) can't be selected between: there is no branchless lowering.
program {
    fn run() -> extern Pair {
        return select(true, new Pair { a: 1.0, b: 2 }, new Pair { a: 3.0, b: 4 });
    }
    unit u { main run; }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(SelectType)
