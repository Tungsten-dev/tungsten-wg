// `a` evaluates `b`, which evaluates `a` through a helper.
program {
    fn a_main() -> f64 { return eval(b, ambient(pos3)) @origin_scale(1, 1, 1) @position_scale(1, 1, 1); }
    unit a { main a_main; }
    fn back() -> f64 { return eval(a, pos3(0, 0, 0)) @origin_scale(1, 1, 1) @position_scale(1, 1, 1); }
    fn b_main() -> f64 { return back(); }
    unit b { main b_main; helpers [back]; }
    entry a @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(EvalCycle)
