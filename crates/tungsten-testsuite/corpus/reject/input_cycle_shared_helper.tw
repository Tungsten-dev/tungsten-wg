// `a` is the source of `d`, and reaches `d` through `g`, a helper it shares with `b`.
program {
    fn g() -> i32 { return density(d); }
    fn a_main() -> i32 { return (g() + 1); }
    unit a { main a_main; helpers [g]; inputs [d]; }
    input d = a @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn b_main() -> i32 { return g(); }
    unit b { main b_main; helpers [g]; inputs [d]; }
    entry b @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(Cycle)
