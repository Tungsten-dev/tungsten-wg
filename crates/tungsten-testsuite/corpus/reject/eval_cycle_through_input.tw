// `top` evaluates `probe`, which reads a buffer of `top`.
program {
    input t = top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn probe_main() -> f64 { return density(t, 0); }
    unit probe { main probe_main; inputs [t]; }
    fn top_main() -> f64 { return eval(probe, ambient(pos3)) @origin_scale(1, 1, 1) @position_scale(1, 1, 1); }
    unit top { main top_main; }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(EvalCycle)
