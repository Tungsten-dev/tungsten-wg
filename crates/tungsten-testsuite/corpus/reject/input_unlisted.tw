// A read of an input that no unit lists.
program {
    fn leaf() -> i32 { return 1; }
    unit leaf_u { main leaf; }
    input d = leaf_u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    fn top() -> i32 { return density(d); }
    unit u { main top; }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(InputNotListed)
