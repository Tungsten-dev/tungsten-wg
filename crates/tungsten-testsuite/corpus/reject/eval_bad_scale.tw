// Every scale component must be finite.
program {
    fn probe_main() -> f64 { return 1.0; }
    unit probe { main probe_main; }
    fn top_main() -> f64 { return eval(probe, ambient(pos3)) @origin_scale(1, inf, 1) @position_scale(1, 1, 1); }
    unit top { main top_main; }
    entry top @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@expect reject(EvalBadScale)
