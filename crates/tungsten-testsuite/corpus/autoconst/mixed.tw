// A handle and value autoconsts of every scalar type, fed by params of every type.
program {
    param seed: i64;
    param scale: f64;
    param flip: bool;
    auto t: handle PerlinNoiseSampler = make_permutation_table(param(seed), 1L, 2L, 3L, 4L, 5L);
    auto sc: f64 = make_scale(param(scale), param(flip));
    auto fl: bool = make_flag(param(flip), param(seed));
    auto sl: i64 = make_salt(param(seed), "caves");
    auto b8: i8 = make_i8(param(seed));
    auto b32: i32 = make_i32(param(seed));
    auto f32v: f32 = make_f32(param(scale));
    fn reals() -> [f64; 2] {
        return [auto(sc), (auto(f32v) as f64)];
    }
    fn ints() -> [i64; 3] {
        return [auto(sl), (auto(b8) as i64), (auto(b32) as i64)];
    }
    fn flags() -> [bool; 2] {
        return [auto(fl), (ext perm_get(auto(t), 3) == ext perm_get(auto(t), 259))];
    }
    unit ur { main reals; autos [sc, f32v]; }
    unit ui { main ints; autos [sl, b8, b32]; }
    unit uf { main flags; autos [fl, t]; }
    entry ur @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry ui @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry uf @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "a" origin(0, 0, 0) param(seed = 300, scale = 1.5, flip = true)
@case "b" origin(0, 0, 0) param(seed = -4294967297, scale = 0.1, flip = false)
@case "c" origin(0, 0, 0) param(seed = -9223372036854775808, scale = -0.0, flip = true)
@expect "a" ur[0, 0, 0] = [-1.5, 1.5]
@expect "a" ui[0, 0, 0] = [-6725406997536941843L, 44L, 300L]
@expect "a" uf[0, 0, 0] = [true, true]
@expect "b" ur[0, 0, 0] = [0.1, 0.10000000149011612]
@expect "b" ui[0, 0, 0] = [-1990056611973702420L, -1L, -1L]
@expect "b" uf[0, 0, 0] = [false, true]
@expect "c" ur[0, 0, 0] = [0.0, -0.0]
@expect "c" ui[0, 0, 0] = [6041658318868353905L, 0L, 0L]
@expect "c" uf[0, 0, 0] = [false, true]
