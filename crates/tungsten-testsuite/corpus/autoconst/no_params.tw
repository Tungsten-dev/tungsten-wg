// No params: a handle built from literals only.
program {
    auto t: handle PerlinNoiseSampler = make_permutation_table(-9223372036854775808L, 9223372036854775807L, 0L, -1L, 1L, 2L);
    fn run() -> bool {
        return (ext perm_get(auto(t), 9) == ext perm_get(auto(t), 265));
    }
    unit u { main run; autos [t]; }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0)
@expect "c" u[0, 0, 0] = true
