// Params named like the names creation code uses. Each stays a distinct, working parameter.
program {
    param buffers: i64;
    param out: f64;
    param this: bool;
    param impl: i64;
    param auto_consts: i64;
    param auto_constants: i64;
    param _init: i64;
    auto sb: i64 = make_salt(param(buffers), "b");
    auto ob: i64 = make_bits(param(out));
    auto tf: bool = make_flag(param(this), param(impl));
    auto sa: i64 = make_salt(param(auto_consts), "a");
    auto sc: i64 = make_salt(param(auto_constants), "c");
    auto si: i64 = make_salt(param(_init), "i");
    fn run() -> [i64; 5] {
        return [auto(sb), auto(ob), auto(sa), auto(sc), auto(si)];
    }
    fn flag() -> bool {
        return auto(tf);
    }
    unit u { main run; autos [sb, ob, sa, sc, si]; }
    unit f { main flag; autos [tf]; }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry f @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) param(buffers = 11, out = 2.5, this = true, impl = 5, auto_consts = -3, auto_constants = 77, _init = -9)
@expect "c" u[0, 0, 0] = [-5808548077060883932L, 4612811918334230528L, 5808553574619024987L, -5808619545316717647L, 5808555773642281409L]
@expect "c" f[0, 0, 0] = true
