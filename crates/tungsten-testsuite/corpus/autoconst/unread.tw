// An autoconst nothing reads is still built, and one no unit lists stays inert. Neither changes the result.
program {
    param seed: i64;
    auto unread_handle: handle PerlinNoiseSampler = make_permutation_table(param(seed), 1L, 2L, 3L, 4L, 5L);
    auto unread_value: i64 = make_salt(param(seed), "unread");
    auto unlisted: i64 = make_bits(-0.0);
    auto listed_unread: bool = make_flag(true, 1L);
    fn run() -> i32 {
        return 42;
    }
    unit u { main run; autos [unread_handle, listed_unread]; }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) param(seed = 9)
@expect "c" u[0, 0, 0] = 42
