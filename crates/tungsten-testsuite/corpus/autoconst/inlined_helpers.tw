// Helpers read each kind of autoconst. Inlining them into the main moves the reads, and the unit's
// lists must stay complete: the result is the same with and without it.
program {
    param seed: i64;
    auto t: handle PerlinNoiseSampler = make_permutation_table(param(seed), 1L, 2L, 3L, 4L, 5L);
    auto sl: i64 = make_salt(param(seed), "inline");
    auto sc: f64 = make_scale(2.5, true);
    fn handle_read(i: i32) -> bool {
        return (ext perm_get(auto(t), i) == ext perm_get(auto(t), (i + 256)));
    }
    fn value_read() -> f64 {
        return ((auto(sl) as f64) + auto(sc));
    }
    fn run() -> f64 {
        if handle_read(7) {
            return value_read();
        }
        return 0.0;
    }
    unit u { main run; helpers [handle_read, value_read]; autos [t, sl, sc]; }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) param(seed = 5)
@expect "c" u[0, 0, 0] = 4.952105598574405e+18
