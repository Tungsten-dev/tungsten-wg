// Per-entry hosts (specs/workers.md §8): `ab` reads a and b, `bc` reads b and c (overlapping on b),
// `c_only` reads c (disjoint from `ab`), `d_through_input` reads d only through an input, and
// `none` reads no host. Each worker's host struct holds only its own.
program {
    host a: f64;
    host b: f64;
    host c: i32;
    host d: f64;

    fn ab_main() -> f64 @hosts(a, b) {
        return (host(a) + host(b));
    }
    unit ab {
        main ab_main;
        hosts [a, b];
    }

    fn bc_main() -> f64 @hosts(b, c) {
        return (host(b) * (host(c) as f64));
    }
    unit bc {
        main bc_main;
        hosts [b, c];
    }

    fn c_main() -> i32 @hosts(c) {
        return (host(c) + 1);
    }
    unit c_only {
        main c_main;
        hosts [c];
    }

    fn d_main() -> f64 @hosts(d) {
        return host(d);
    }
    unit du {
        main d_main;
        hosts [d];
    }
    input d_in = du @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);

    fn through_main() -> f64 {
        return (density(d_in) * 4.0);
    }
    unit d_through_input {
        main through_main;
        inputs [d_in];
    }

    fn none_main() -> f64 {
        return 9.0;
    }
    unit none {
        main none_main;
    }

    entry ab @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry bc @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry c_only @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry d_through_input @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
    entry none @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
@case "c" origin(0, 0, 0) host(a = 1.5, b = 2.0, c = 3, d = 0.25)
@expect "c" ab[0, 0, 0] = 3.5
@expect "c" bc[0, 0, 0] = 6.0
@expect "c" c_only[0, 0, 0] = 4
@expect "c" d_through_input[0, 0, 0] = 1.0
@expect "c" none[0, 0, 0] = 9.0
